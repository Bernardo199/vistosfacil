@model VistosFacil.Core.Entities.Article
@{ Layout = "_AdminLayout"; ViewData["Title"] = Model.Id > 0 ? "Editar Artigo" : "Novo Artigo"; }
<h1 class="page-title">@ViewData["Title"]</h1>
<form method="post" style="max-width:860px;">
  @Html.AntiForgeryToken()
  <div class="form-grid">
    <div><label>Título *</label><input name="Title" type="text" value="@Model.Title" required></div>
    <div>
      <label>Categoria *</label>
      <select name="CategoryId" required>
        <option value="">Seleccionar...</option>
        @foreach (var cat in (IEnumerable<VistosFacil.Core.Entities.Category>)ViewBag.Categories)
        { <option value="@cat.Id" selected="@(Model.CategoryId==cat.Id?"selected":null)">@cat.Emoji @cat.Name</option> }
      </select>
    </div>
  </div>
  <label>Resumo *</label>
  <textarea name="Summary" rows="3" required>@Model.Summary</textarea>
  <label>Corpo do artigo (HTML permitido)</label>
  <textarea name="Body" rows="18" style="font-family:'IBM Plex Mono',monospace;font-size:.86rem;">@Model.Body</textarea>
  <div class="form-grid">
    <div><label>URL da imagem</label><input name="ImageUrl" type="text" value="@Model.ImageUrl" placeholder="https://..."></div>
    <div><label>Slug (deixar vazio para gerar automaticamente)</label><input name="Slug" type="text" value="@Model.Slug" placeholder="gerado-automaticamente"></div>
  </div>
  <div class="form-grid">
    <div><label>Meta Title (SEO)</label><input name="MetaTitle" type="text" value="@Model.MetaTitle"></div>
    <div><label>Meta Description (SEO)</label><input name="MetaDescription" type="text" value="@Model.MetaDescription"></div>
  </div>
  <div style="display:flex;gap:28px;margin-bottom:24px;">
    <label style="display:flex;align-items:center;gap:8px;text-transform:none;font-size:1rem;cursor:pointer;">
      <input type="checkbox" name="Published" value="true" @(Model.Published?"checked":"") style="width:18px;height:18px;margin:0;accent-color:#1E8449;">
      Publicado
    </label>
    <label style="display:flex;align-items:center;gap:8px;text-transform:none;font-size:1rem;cursor:pointer;">
      <input type="checkbox" name="Featured" value="true" @(Model.Featured?"checked":"") style="width:18px;height:18px;margin:0;accent-color:#D4AC0D;">
      Destaque
    </label>
  </div>
  <div style="display:flex;gap:12px;">
    <button type="submit" class="btn-admin btn-primary">@(Model.Id>0?"Guardar":"Criar artigo")</button>
    <a href="/admin/artigos" class="btn-admin btn-secondary">Cancelar</a>
  </div>
</form>
