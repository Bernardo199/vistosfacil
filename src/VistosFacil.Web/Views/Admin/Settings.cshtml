@model Dictionary<string, string>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Configurações"; }
<h1 class="page-title">Configurações</h1>
<form method="post" style="max-width:700px;">
  @Html.AntiForgeryToken()
  @foreach (var kv in Model)
  {
    <label>@kv.Key</label>
    <input name="configs[@kv.Key]" type="text" value="@kv.Value" placeholder="Não configurado">
  }
  <button type="submit" class="btn-admin btn-primary">Guardar</button>
</form>
