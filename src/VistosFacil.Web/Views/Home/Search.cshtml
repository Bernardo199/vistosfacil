@model VistosFacil.Web.ViewModels.SearchViewModel
@{ ViewData["Title"] = "Pesquisa — " + Model.Query; }
<main style="padding:48px 0;">
  <div class="wrap">
    <h1 style="margin-bottom:24px;">Resultados de pesquisa</h1>
    <form action="/pesquisa" method="get" style="display:flex;gap:0;max-width:560px;margin-bottom:36px;">
      <input name="q" type="search" value="@Model.Query" class="search-input" placeholder="Pesquisar guias..." style="border-radius:999px 0 0 999px;border-right:none;">
      <button type="submit" class="search-btn" style="border-radius:0 999px 999px 0;">Pesquisar</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.Query))
    {
      <p style="font-family:'IBM Plex Mono',monospace;font-size:.8rem;color:var(--texto-3);margin-bottom:24px;">@Model.Results.Count resultado(s) para "<strong>@Model.Query</strong>"</p>
      @if (Model.Results.Any())
      {
        <div class="grid-3">
          @foreach (var a in Model.Results)
          {
            var em = a.Category?.Slug switch { "vistos-portugal"=>"🇵🇹","vistos-eua"=>"🇺🇸","vistos-schengen"=>"🇪🇺","autorizacao-residencia"=>"🏠","nacionalidade"=>"📜","vistos-brasil"=>"🇧🇷",_=>"📋" };
            <div class="article-card">
              <div class="article-card-img"><span style="font-size:3rem;">@em</span></div>
              <div class="article-card-body">
                <span class="card-tag tag-@(a.Category?.Slug?.Split('-')[0]??"guia")">@a.Category?.TagLabel</span>
                <h3><a href="/artigo/@a.Slug">@a.Title</a></h3>
                <p>@(a.Summary.Length>110?a.Summary.Substring(0,110)+"...":a.Summary)</p>
              </div>
            </div>
          }
        </div>
      }
      else { <p>Nenhum resultado. Tenta outras palavras.</p> }
    }
  </div>
</main>
