@model VistosFacil.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = null;
    ViewData["Description"] = "Guia completo de vistos para Portugal, EUA, Schengen e mais — explicado em português para cabo-verdianos e lusófonos. Informação actualizada 2026.";
}

<section class="hero">
  <div class="wrap">
    <div class="hero-inner">
      <div>
        <span class="hero-eyebrow">Actualizado 2026 · Informação gratuita</span>
        <h1>O guia de <span>vistos e imigração</span> em português</h1>
        <p class="hero-lead">Tudo o que precisas de saber sobre vistos para Portugal, EUA, Schengen e muito mais — explicado de forma clara para cabo-verdianos e todos os lusófonos.</p>
        <div class="hero-btns">
          <a href="/europa/portugal/residencia" class="btn btn-primary">🇵🇹 Viver em Portugal</a>
          <a href="/eua/turismo" class="btn btn-secondary">🇺🇸 Visto EUA</a>
          <a href="/guias/documentos" class="btn btn-ghost">Ver todos os guias</a>
        </div>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><span class="num">15+</span><span class="label">Tipos de visto</span></div>
        <div class="hero-stat"><span class="num">50+</span><span class="label">Guias detalhados</span></div>
        <div class="hero-stat"><span class="num">PT</span><span class="label">Em português</span></div>
        <div class="hero-stat"><span class="num">2026</span><span class="label">Actualizado</span></div>
        <div class="hero-stat"><span class="num">✓</span><span class="label">Gratuito</span></div>
        <div class="hero-stat"><span class="num">🌍</span><span class="label">Lusófonos</span></div>
      </div>
    </div>
  </div>
</section>

<div style="background:var(--branco);border-bottom:1px solid var(--cinza-2);padding:20px 0;">
  <div class="wrap">
    <form action="/pesquisa" method="get" style="display:flex;gap:0;max-width:600px;margin:0 auto;">
      <input name="q" type="search" class="search-input" placeholder="Pesquisa: visto D7, autorização residência, green card..." style="border-radius:999px 0 0 999px;border-right:none;">
      <button type="submit" class="search-btn" style="border-radius:0 999px 999px 0;">Pesquisar</button>
    </form>
  </div>
</div>

<section class="section" style="background:var(--branco);padding:48px 0;">
  <div class="wrap">
    <div class="section-head" style="text-align:center;">
      <span class="eyebrow">Para onde queres ir?</span>
      <h2>Escolhe o teu destino</h2>
    </div>
    <div class="dest-grid">
      <a href="/europa/portugal/residencia" class="dest-card"><span class="flag">🇵🇹</span><h3>Portugal</h3><p>Vistos, residência e nacionalidade</p><span class="count">7 guias disponíveis</span></a>
      <a href="/europa/schengen/turismo" class="dest-card"><span class="flag">🇪🇺</span><h3>Europa Schengen</h3><p>26 países com visto único</p><span class="count">3 guias disponíveis</span></a>
      <a href="/eua/turismo" class="dest-card"><span class="flag">🇺🇸</span><h3>Estados Unidos</h3><p>Turismo, estudo e imigração</p><span class="count">5 guias disponíveis</span></a>
      <a href="/categoria/vistos-brasil" class="dest-card"><span class="flag">🇧🇷</span><h3>Brasil</h3><p>Visto de turismo e trabalho</p><span class="count">2 guias disponíveis</span></a>
      <a href="/europa/reino-unido/turismo" class="dest-card"><span class="flag">🇬🇧</span><h3>Reino Unido</h3><p>Pós-Brexit: tudo mudou</p><span class="count">2 guias disponíveis</span></a>
      <a href="/guias/documentos" class="dest-card"><span class="flag">🌍</span><h3>Outros destinos</h3><p>Canadá, Austrália e mais</p><span class="count">Ver todos</span></a>
    </div>
  </div>
</section>

@if (Model.FeaturedArticles.Any())
{
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Guias essenciais</span>
      <h2>Os mais lidos esta semana</h2>
      <p>Os guias mais consultados pelos nossos leitores — actualizados com as últimas mudanças de 2026.</p>
    </div>
    <div class="grid-3">
      @foreach (var a in Model.FeaturedArticles)
      {
        var em = a.Category?.Slug switch { "vistos-portugal"=>"🇵🇹","vistos-eua"=>"🇺🇸","vistos-schengen"=>"🇪🇺","autorizacao-residencia"=>"🏠","nacionalidade"=>"📜","vistos-brasil"=>"🇧🇷",_=>"📋" };
        <div class="article-card">
          <div class="article-card-img"><span style="font-size:3.5rem;">@em</span></div>
          <div class="article-card-body">
            <span class="card-tag tag-@(a.Category?.Slug?.Split('-')[0]??"guia")">@a.Category?.TagLabel</span>
            <h3><a href="/artigo/@a.Slug">@a.Title</a></h3>
            <p>@(a.Summary.Length>120?a.Summary.Substring(0,120)+"...":a.Summary)</p>
            <div class="card-meta"><span>@a.CreatedAt.ToString("d MMM yyyy")</span></div>
          </div>
        </div>
      }
    </div>
  </div>
</section>
}

<div class="wrap"><div class="ad-slot">ESPAÇO PUBLICITÁRIO — Google AdSense</div></div>

<section class="section" style="background:var(--branco);">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Por tipo de guia</span><h2>O que precisas de saber</h2></div>
    <div class="grid-4">
      <a href="/guias/documentos" class="card" style="text-decoration:none;"><div class="card-icon">📄</div><h3>Documentos</h3><p>Listas completas de documentos para cada tipo de visto.</p></a>
      <a href="/guias/passo-a-passo" class="card" style="text-decoration:none;"><div class="card-icon">📋</div><h3>Passo a passo</h3><p>Guias detalhados do processo do início ao fim.</p></a>
      <a href="/guias/entrevista" class="card" style="text-decoration:none;"><div class="card-icon">🎤</div><h3>Entrevista consular</h3><p>Como te preparar e o que esperar no consulado.</p></a>
      <a href="/guias/custos-prazos" class="card" style="text-decoration:none;"><div class="card-icon">💰</div><h3>Custos e prazos</h3><p>Quanto custa e quanto tempo demora em 2026.</p></a>
      <a href="/guias/recusas-recursos" class="card" style="text-decoration:none;"><div class="card-icon">❌</div><h3>Recusas e recursos</h3><p>O que fazer quando o visto é recusado.</p></a>
      <a href="/checklist" class="card" style="text-decoration:none;"><div class="card-icon">✅</div><h3>Checklist</h3><p>Não te esqueças de nenhum documento.</p></a>
      <a href="/prazos" class="card" style="text-decoration:none;"><div class="card-icon">⏱</div><h3>Prazos 2026</h3><p>Tempos de processamento actualizados.</p></a>
      <a href="/blog" class="card" style="text-decoration:none;"><div class="card-icon">✍️</div><h3>Blog</h3><p>Notícias e actualizações sobre imigração.</p></a>
    </div>
  </div>
</section>

@if (Model.AllArticles.Any())
{
<section class="section">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Biblioteca de guias</span><h2>@Model.TrendingTitle</h2></div>
    <div class="cat-pills">
      <button class="cat-pill active" onclick="filterCat('all',this)">Todos</button>
      @foreach (var cat in Model.Categories)
      { <button class="cat-pill" onclick="filterCat('@cat.Slug',this)">@cat.Emoji @cat.Name</button> }
    </div>
    <div class="grid-3" id="articles-grid">
      @foreach (var a in Model.AllArticles)
      {
        var em2 = a.Category?.Slug switch { "vistos-portugal"=>"🇵🇹","vistos-eua"=>"🇺🇸","vistos-schengen"=>"🇪🇺","autorizacao-residencia"=>"🏠","nacionalidade"=>"📜","vistos-brasil"=>"🇧🇷",_=>"📋" };
        <div class="article-card" data-cat="@a.Category?.Slug">
          <div class="article-card-img"><span style="font-size:3rem;">@em2</span></div>
          <div class="article-card-body">
            <span class="card-tag tag-@(a.Category?.Slug?.Split('-')[0]??"guia")">@a.Category?.TagLabel</span>
            <h3><a href="/artigo/@a.Slug">@a.Title</a></h3>
            <p>@(a.Summary.Length>110?a.Summary.Substring(0,110)+"...":a.Summary)</p>
            <div class="card-meta"><span>@a.CreatedAt.ToString("d MMM yyyy")</span></div>
          </div>
        </div>
      }
    </div>
    @if (Model.TotalPages > 1)
    {
      <div style="display:flex;justify-content:center;gap:10px;margin-top:40px;">
        @if (Model.CurrentPage > 1) { <a href="/?page=@(Model.CurrentPage-1)" class="btn btn-outline">← Anterior</a> }
        <span style="font-family:'IBM Plex Mono',monospace;font-size:.82rem;padding:12px 0;color:var(--texto-3);">Página @Model.CurrentPage de @Model.TotalPages</span>
        @if (Model.CurrentPage < Model.TotalPages) { <a href="/?page=@(Model.CurrentPage+1)" class="btn btn-primary">Seguinte →</a> }
      </div>
    }
  </div>
</section>
}

<div class="wrap" style="margin-bottom:40px;">
  <div class="info-box info-yellow">⚠️ <strong>Aviso importante:</strong> O VistosFácil fornece informação de carácter geral. As leis de imigração mudam frequentemente — verifique sempre nas fontes oficiais antes de tomar decisões.</div>
</div>

<section style="padding:0 0 64px;">
  <div class="wrap">
    <div class="newsletter-box">
      <div><h3>📬 Alertas de mudanças nos vistos</h3><p>Recebe notificações quando as regras mudam — antes que te apanhem desprevenido.</p></div>
      <form id="newsletter-form" class="newsletter-form">
        <input id="newsletter-email" type="email" class="newsletter-input" placeholder="o.seu@email.com" required>
        <button type="submit" class="newsletter-btn">Subscrever grátis</button>
      </form>
    </div>
    <p id="newsletter-msg" style="display:none;margin-top:12px;text-align:center;font-size:.9rem;"></p>
  </div>
</section>

@section Scripts {
<script>
function filterCat(cat, btn) {
  document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.article-card[data-cat]').forEach(card => {
    card.style.display = (cat === 'all' || card.dataset.cat === cat) ? 'block' : 'none';
  });
}
document.getElementById('newsletter-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('newsletter-email').value;
  const res = await fetch('/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: `email=${encodeURIComponent(email)}` });
  const data = await res.json();
  const msg = document.getElementById('newsletter-msg');
  msg.style.display = 'block';
  msg.style.color = data.success ? '#1E8449' : '#C0392B';
  msg.textContent = data.message;
  if (data.success) this.reset();
});
</script>
}
