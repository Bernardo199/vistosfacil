@{ ViewData["Title"] = "Contacto"; }
<main style="padding:56px 0 64px;"><div class="wrap" style="max-width:600px;">
<div class="breadcrumb"><a href="/">Início</a><span class="sep">›</span><span>Contacto</span></div>
<h1 style="font-size:2rem;margin-bottom:8px;">Contacto</h1>
<p style="color:var(--texto-2);margin-bottom:32px;">Para sugestões, correcções ou parcerias.</p>
<form id="contacto-form" style="display:flex;flex-direction:column;gap:16px;">
  <div><label style="display:block;font-family:'IBM Plex Mono',monospace;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--texto-3);margin-bottom:6px;">Nome</label>
  <input type="text" style="width:100%;padding:12px 14px;border:1.5px solid var(--cinza-2);border-radius:8px;font-size:1rem;outline:none;"></div>
  <div><label style="display:block;font-family:'IBM Plex Mono',monospace;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--texto-3);margin-bottom:6px;">Email</label>
  <input type="email" style="width:100%;padding:12px 14px;border:1.5px solid var(--cinza-2);border-radius:8px;font-size:1rem;outline:none;" placeholder="o.seu@email.com"></div>
  <div><label style="display:block;font-family:'IBM Plex Mono',monospace;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--texto-3);margin-bottom:6px;">Mensagem</label>
  <textarea rows="5" style="width:100%;padding:12px 14px;border:1.5px solid var(--cinza-2);border-radius:8px;font-size:1rem;font-family:'Source Serif 4',serif;outline:none;"></textarea></div>
  <button type="submit" onclick="this.closest('form').querySelector('p')&&(document.getElementById('c-msg').style.display='block');return false;" class="btn btn-primary" style="align-self:flex-start;">Enviar mensagem</button>
</form>
<p id="c-msg" style="display:none;margin-top:16px;color:var(--verde);">Mensagem enviada! Responderemos em breve.</p>
</div></main>
@section Scripts {
<script>
document.getElementById('contacto-form').addEventListener('submit', function(e) {
  e.preventDefault();
  document.getElementById('c-msg').style.display = 'block';
  this.reset();
});
</script>
}
